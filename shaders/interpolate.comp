#version 450

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D previous_frame;
layout(set = 0, binding = 1) uniform sampler2D next_frame;
layout(set = 0, binding = 2, std430) readonly buffer FlowVectors {
    uint packed_vectors[];
} flow_vectors;
layout(set = 0, binding = 3, rgba8) uniform writeonly image2D interpolated_frame;

vec2 flow_at(ivec2 cell, ivec2 flow_dimensions) {
    ivec2 bounded_cell = clamp(cell, ivec2(0), flow_dimensions - 1);
    uint packed_flow = flow_vectors.packed_vectors[
        bounded_cell.y * flow_dimensions.x + bounded_cell.x
    ];
    ivec2 flow = ivec2(int(packed_flow << 16) >> 16, int(packed_flow) >> 16);
    return vec2(flow) / 32.0;
}

bool inside_image(vec2 pixel, ivec2 dimensions) {
    return all(greaterThanEqual(pixel, vec2(0.0)))
        && all(lessThanEqual(pixel, vec2(dimensions - 1)));
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dimensions = imageSize(interpolated_frame);
    if (any(greaterThanEqual(pixel, dimensions))) {
        return;
    }

    ivec2 flow_dimensions = (dimensions + 3) / 4;
    vec2 grid_position = (vec2(pixel) + 0.5) / 4.0 - 0.5;
    ivec2 grid_cell = ivec2(floor(grid_position));
    vec2 grid_fraction = fract(grid_position);
    vec2 top_left = flow_at(grid_cell, flow_dimensions);
    vec2 top_right = flow_at(grid_cell + ivec2(1, 0), flow_dimensions);
    vec2 bottom_left = flow_at(grid_cell + ivec2(0, 1), flow_dimensions);
    vec2 bottom_right = flow_at(grid_cell + ivec2(1, 1), flow_dimensions);
    vec2 top_flow = mix(top_left, top_right, grid_fraction.x);
    vec2 bottom_flow = mix(bottom_left, bottom_right, grid_fraction.x);
    vec2 motion = mix(top_flow, bottom_flow, grid_fraction.y);
    float disagreement = max(
        max(length(top_left - motion), length(top_right - motion)),
        max(length(bottom_left - motion), length(bottom_right - motion))
    );
    float flow_confidence = 1.0 - smoothstep(4.0, 12.0, disagreement);
    vec2 previous_pixel = vec2(pixel) - motion * 0.5;
    vec2 next_pixel = vec2(pixel) + motion * 0.5;
    vec2 extent = vec2(dimensions);
    vec4 blended_color = (
        texture(previous_frame, (vec2(pixel) + 0.5) / extent)
        + texture(next_frame, (vec2(pixel) + 0.5) / extent)
    ) * 0.5;
    if (!inside_image(previous_pixel, dimensions) || !inside_image(next_pixel, dimensions)) {
        imageStore(interpolated_frame, pixel, blended_color);
        return;
    }

    vec4 previous_color = texture(previous_frame, (previous_pixel + 0.5) / extent);
    vec4 next_color = texture(next_frame, (next_pixel + 0.5) / extent);
    float color_disagreement = max(max(
        abs(previous_color.r - next_color.r),
        abs(previous_color.g - next_color.g)
    ), abs(previous_color.b - next_color.b));
    float correspondence_confidence = 1.0 - smoothstep(0.08, 0.25, color_disagreement);
    flow_confidence *= correspondence_confidence;
    vec4 compensated_color = (previous_color + next_color) * 0.5;
    imageStore(interpolated_frame, pixel, mix(blended_color, compensated_color, flow_confidence));
}
