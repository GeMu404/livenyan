#version 450

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D source_texture;
layout(set = 0, binding = 1, rgba8) uniform image2D target_image;

layout(push_constant) uniform DrawParameters {
    vec4 destination;
    vec2 target_size;
    vec2 dispatch_origin;
    vec4 source_uv;
    vec4 color;
    int flags;
} draw_parameters;

void main() {
    ivec2 pixel = ivec2(draw_parameters.dispatch_origin) + ivec2(gl_GlobalInvocationID.xy);
    ivec2 target_size = imageSize(target_image);
    if (any(greaterThanEqual(pixel, target_size))) {
        return;
    }

    vec2 center = vec2(pixel) + 0.5;
    vec4 destination = draw_parameters.destination;
    bool clear = (draw_parameters.flags & 4) != 0;
    if (!clear && (any(lessThan(center, destination.xy)) ||
                   any(greaterThanEqual(center, destination.xy + destination.zw)))) {
        return;
    }

    vec4 source = draw_parameters.color;
    if ((draw_parameters.flags & 1) != 0) {
        vec2 local_uv = (center - destination.xy) / destination.zw;
        vec2 uv = draw_parameters.source_uv.xy + local_uv * draw_parameters.source_uv.zw;
        source *= texture(source_texture, uv);
    }

    if ((draw_parameters.flags & 2) != 0) {
        vec4 destination_color = imageLoad(target_image, pixel);
        float alpha = clamp(source.a, 0.0, 1.0);
        source.rgb = source.rgb * alpha + destination_color.rgb * (1.0 - alpha);
        source.a = alpha + destination_color.a * (1.0 - alpha);
    }
    imageStore(target_image, pixel, source);
}
